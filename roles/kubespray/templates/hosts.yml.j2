---
# Kubespray inventory generated from Ansible inventory.
# {{ ansible_managed }}

all:
  vars:
    ansible_ssh_private_key_file: "{{ ssh_key_path }}"
  hosts:
{% for host in groups['all'] %}
    {{ host }}:
      ansible_host: {{ hostvars[host].internal_ip | default(hostvars[host].ansible_host) }}
      ip: {{ hostvars[host].internal_ip | default(hostvars[host].ansible_host) }}
      access_ip: {{ hostvars[host].internal_ip | default(hostvars[host].ansible_host) }}
      ansible_user: {{ hostvars[host].ansible_user }}
{% endfor %}
  children:
    kube_control_plane:
      hosts:
{% for host in groups['control_plane'] %}
        {{ host }}: {}
{% endfor %}
    kube_node:
      hosts:
{% for host in groups['all'] %}
        {{ host }}: {}
{% endfor %}
    etcd:
      hosts:
{% for host in groups['control_plane'] %}
        {{ host }}: {}
{% endfor %}
    k8s_cluster:
      children:
        kube_control_plane: {}
        kube_node: {}
    calico_rr:
      hosts: {}
