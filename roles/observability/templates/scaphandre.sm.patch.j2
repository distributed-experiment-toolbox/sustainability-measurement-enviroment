{
    "spec": {
        "endpoints": [
            {
                "port": "metrics",
                "interval": "10s",
                "scrapeTimeout": "5s",
                "relabelings": [
                    {
                        "sourceLabels": ["__meta_kubernetes_pod_node_name"],
                        "targetLabel": "node",
                        "action": "replace"
                    }
                ]
            }
        ],
        "fallbackScrapeProtocol": "PrometheusText0.0.4"
    }
}
